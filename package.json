{
  "name": "moul-workspace",
  "private": true,
  "type": "module",
  "description": "TypeScript packages and sites beside the Moul crates.",
  "workspaces": [
    "packages/*",
    "sites/*"
  ],
  "scripts": {
    "build:wasm": "scripts/build-wasm.sh",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
