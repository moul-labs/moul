		Type string `json:"type"`
		Name string `json:"name"`
		Tbl  string `json:"table"`
		SQL  string `json:"sql"`
	}
	var schema []object
	rows, err := conn.QueryContext(ctx, `SELECT type, name, tbl_name, sql FROM sqlite_master WHERE sql IS NOT NULL AND name NOT LIKE 'sqlite_%' ORDER BY type DESC, name`)
	if err != nil {
		return "", err.Error()
	}
	for rows.Next() {
		var o object
		if err := rows.Scan(&o.Type, &o.Name, &o.Tbl, &o.SQL); err != nil {
			rows.Close()
			return "", err.Error()
		}
		schema = append(schema, o)
	}
	rows.Close()

	const maxRows = 1000
	tables := map[string]any{}
	for _, o := range schema {
		if o.Type != "table" {
			continue
		}
		r, err := conn.QueryContext(ctx, `SELECT * FROM "`+o.Name+`" LIMIT `+itoa(maxRows+1))
		if err != nil {
			tables[o.Name] = map[string]any{"error": err.Error()}
			continue
		}
		cols, _ := r.Columns()
		var data [][]any
		truncated := false
		for r.Next() {
			if len(data) == maxRows {
				truncated = true
				break
			}
			vals := make([]any, len(cols))
			ptrs := make([]any, len(cols))
			for i := range vals {
				ptrs[i] = &vals[i]
			}
			if err := r.Scan(ptrs...); err != nil {
				break
			}
			for i, v := range vals {
				switch x := v.(type) {
				case []byte:
					vals[i] = map[string]any{"$bytes": base64.StdEncoding.EncodeToString(x)}
				case time.Time:
					vals[i] = map[string]any{"$time": x.UTC().Format(time.RFC3339Nano)}
				}
			}
			data = append(data, vals)
		}
		r.Close()
		t := map[string]any{"columns": cols, "rows": data}
		if truncated {
			t["truncated"] = true
		}
		tables[o.Name] = t
	}

	doc, err := json.MarshalIndent(map[string]any{"schema": schema, "tables": tables}, "", "  ")
	if err != nil {
		return "", err.Error()
	}
	sum := sha256.Sum256(doc)
	id := hex.EncodeToString(sum[:])[:16]
	dir := filepath.Join(moulfxDir, "db")
	_ = os.MkdirAll(dir, 0o755)
	path := filepath.Join(dir, id+".json")
	if _, err := os.Stat(path); err != nil {
		_ = os.WriteFile(path, append(doc, '\n'), 0o644)
	}
	return id, ""
}
