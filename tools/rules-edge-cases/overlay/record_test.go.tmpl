// moulecCase is one line of input. Without "kind" it is a rules.EvaluateRule
// call; "filter" and "sort" are rules.BuildFilterSQLWithOptions and
// rules.BuildSortSQLWithOptions.
type moulecCase struct {
	Kind    string                 `json:"kind"`
	Auth    map[string]interface{} `json:"auth"`
	Context map[string]interface{} `json:"context"`

	Rule   string                 `json:"rule"`
	Record map[string]interface{} `json:"record"`
	Setup  []string               `json:"setup"`

	Filter      string                  `json:"filter"`
	Moul        *schema.Moul            `json:"moul"`
	ParamPrefix string                  `json:"param_prefix"`
	Untrusted   bool                    `json:"untrusted"`
	Loader      map[string]*schema.Moul `json:"loader"`
}

func TestMoulecRecord(t *testing.T) {
	in, out := os.Getenv("MOULEC_IN"), os.Getenv("MOULEC_OUT")
	if in == "" || out == "" {
		t.Skip("run by moul-labs/moul tools/rules-edge-cases")
	}
	src, err := os.Open(in)
	if err != nil {
		t.Fatal(err)
	}
	defer src.Close()
	var lines []string
	sc := bufio.NewScanner(src)
	sc.Buffer(make([]byte, 1<<20), 64<<20)
	for n := 1; sc.Scan(); n++ {
		var c moulecCase
		if err := json.Unmarshal(sc.Bytes(), &c); err != nil {
			t.Fatalf("%s:%d: %v", in, n, err)
		}
		answer, err := moulecAnswer(c)
		if err != nil {
			t.Fatalf("%s:%d: %v", in, n, err)
		}
		b, err := json.Marshal(answer)
		if err != nil {
			t.Fatalf("%s:%d: %v", in, n, err)
		}
		lines = append(lines, string(b))
	}
	if err := sc.Err(); err != nil {
		t.Fatal(err)
	}
	if err := os.WriteFile(out, []byte(strings.Join(lines, "\n")+"\n"), 0o644); err != nil {
		t.Fatal(err)
	}
}

func moulecAnswer(c moulecCase) (map[string]interface{}, error) {
	switch c.Kind {
	case "":
		return moulecEvaluate(c)
	case "filter":
		where, params, err := rules.BuildFilterSQLWithOptions(c.Filter, c.Moul, c.Auth, c.Context, rules.FilterOptions{
			ParamPrefix: c.ParamPrefix,
			Untrusted:   c.Untrusted,
			LoadMoul:    moulecLoader(c.Loader),
		})
		return map[string]interface{}{"where": where, "params": params, "error": moulecErr(err)}, nil
	case "sort":
		order, err := rules.BuildSortSQLWithOptions(c.Filter, c.Moul, rules.SortOptions{
			Untrusted: c.Untrusted,
			LoadMoul:  moulecLoader(c.Loader),
		})
		return map[string]interface{}{"order_by": order, "error": moulecErr(err)}, nil
	}
	return nil, fmt.Errorf("unknown kind %q", c.Kind)
}

// moulecEvaluate runs rules.EvaluateRule, on a fresh database when the case
// has setup statements.
func moulecEvaluate(c moulecCase) (map[string]interface{}, error) {
	var conn *dbx.DB
	if c.Setup != nil {
		var err error
		if conn, err = moulecOpen(c.Setup); err != nil {
			return nil, err
		}
		defer conn.Close()
	}
	var ok bool
	var err error
	if c.Context != nil {
		ok, err = rules.EvaluateRule(conn, c.Rule, c.Auth, c.Record, c.Context)
	} else {
		ok, err = rules.EvaluateRule(conn, c.Rule, c.Auth, c.Record)
	}
	return map[string]interface{}{"allowed": ok, "error": moulecErr(err)}, nil
}

// moulecOpen builds an in-memory modernc SQLite database from the setup
// statements and then brings it up to date with db.EnsureSystemTables, as the
// engine does when it opens a database. The setup's _moul has the original
// seven columns; EnsureSystemTables adds email_templates and webhooks, which
// db.LoadMoulByName reads.
func moulecOpen(setup []string) (*dbx.DB, error) {
	conn, err := dbx.Open("sqlite", ":memory:")
	if err != nil {
		return nil, err
	}
	conn.DB().SetMaxOpenConns(1)
	for _, s := range setup {
		if strings.TrimSpace(s) == "" {
			continue
		}
		if _, err := conn.NewQuery(s).Execute(); err != nil {
			conn.Close()
			return nil, fmt.Errorf("setup %q: %w", s, err)
		}
	}
	if err := db.EnsureSystemTables(conn); err != nil {
		conn.Close()
		return nil, err
	}
	return conn, nil
}

func moulecLoader(mouls map[string]*schema.Moul) func(string) (*schema.Moul, error) {
	if mouls == nil {
		return nil
	}
	return func(name string) (*schema.Moul, error) {
		if m, ok := mouls[name]; ok {
			return m, nil
		}
		return nil, errors.New("not found")
	}
}

func moulecErr(err error) interface{} {
	if err == nil {
		return nil
	}
	return err.Error()
}
